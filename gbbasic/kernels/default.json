{
  "id": "default",
  "title": {
    "english": "Default Kernel"
  },
  "description": {
    "english": "The official default kernel.\nImplements Platformer, Top-down,\nand Point&Click controllers.\nSuitable for most game projects."
  },
  "url": "https://github.com/paladin-t/gbb/tree/main/src/vm",
  "kernel": {
    "rom": "gbbvm.gb",
    "symbols": "gbbvm.sym",
    "aliases": "gbbvm.aliases.json",
    "source_code": "gbbvm.zip"
  },
  "bootstrap": {
    "bank": 9
  },
  "memory": {
    "heap_size": "1024",
    "stack_size": "64"
  },
  "objects": {
    "max_actor_count": 21,
    "max_trigger_count": 31
  },
  "snippets": [
    {
      "type": "object",
      "content": [
        "on actor(?) hits start lbl",
        "lbl:",
        "  begin def",
        "    def self = stack1",
        "    def other = stack0",
        "    ' Your code here...",
        "    end",
        "  end def",
        ""
      ],
      "name": {
        "english": "Actor Callback (Hits)"
      }
    },
    {
      "type": "object",
      "content": [
        "on trigger(?) ENTER bor LEAVE start lbl",
        "lbl:",
        "  begin def",
        "    def index = stack1",
        "    def event = stack0",
        "    if event = ENTER then",
        "      ' Your code here...",
        "    else ' if event = LEAVE then",
        "      ' Your code here...",
        "    end if",
        "    end",
        "  end def",
        ""
      ],
      "name": {
        "english": "Trigger Callback"
      }
    },
    {
      "type": "gui",
      "content": [
        "on menu() start lbl",
        "lbl:",
        "  begin def",
        "    def index = stack1",
        "    def event = stack0",
        "    if event = ENTER then",
        "      shell \"^Hand\"",
        "    else if event = LEAVE then",
        "      shell \"^Pointer\"",
        "    end if",
        "    if event = CONFIRM then",
        "      ' Your code here...",
        "    end if",
        "    end",
        "  end def",
        ""
      ],
      "name": {
        "english": "Menu Callback"
      }
    },
    {
      "type": "separator",
      "content": "",
      "name": {
        "english": "-"
      }
    },
    {
      "type": "input",
      "content": [
        "' `BTN` for pressed, `BTND` for button down or `BTNU` for button up.",
        "' Use `UP_BTN`, `DOWN_BTN`, `LEFT_BTN`, `RIGHT_BTN`, `A_BTN`, `B_BTN`, `SELECT_BTN` or `START_BTN` as argument to check for specific button;",
        "' or without argument for any button",
        "on btn() start lbl",
        "lbl:",
        "  ' Your code here...",
        "  end",
        ""
      ],
      "name": {
        "english": "Gamepad Callback"
      }
    },
    {
      "type": "input",
      "content": [
        "' `TOUCH` for pressed, `TOUCHD` for touch down or `TOUCHU` for touch up.",
        "on touch start lbl",
        "lbl:",
        "  begin def",
        "    def x = stack2",
        "    def y = stack1",
        "    def p = stack0",
        "    ' Your code here...",
        "    end",
        "  end def",
        ""
      ],
      "name": {
        "english": "Touch/Mouse Callback"
      }
    },
    {
      "type": "input",
      "content": [
        "' Access to the `KEYM` and `KEYC` registers for keyboard input.",
        "def KEYM = 0xFEA8",
        "def KEYC = 0xFEA9",
        "auto update off",
        "lbl:",
        "  let k = peek(KEYC)   ' Get the key code.",
        "  if k <> 0 then       ' If a key code is available.",
        "    let m = peek(KEYM) ' Get the key modifiers.",
        "    print \"Key pressed %d, %x\", k, m",
        "    poke KEYC, 0       ' Clear the key code, and acknowledge to accept more key codes.",
        "  end if",
        "  update",
        "  goto lbl",
        ""
      ],
      "name": {
        "english": "Keyboard Input"
      }
    },
    {
      "type": "separator",
      "content": "",
      "name": {
        "english": "-"
      }
    },
    {
      "type": "misc",
      "content": [
        "kill                      ' Kill the other threads.",
        "memset(0x8000, 0, 0x2000) ' Reset the VRAM.",
        "option VRAM_BANK, VRAM_BANK1",
        "memset(0x8000, 0, 0x2000)",
        "option VRAM_BANK, VRAM_BANK0",
        "load scene() = nothing    ' Clear the scene and objects.",
        "restore                   ' Reset the data sequence cursor.",
        "randomize                 ' Initialize the random seed.",
        ""
      ],
      "name": {
        "english": "Reset Game Scene"
      }
    }
  ],
